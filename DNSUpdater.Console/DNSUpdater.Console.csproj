<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>17ef8836-9686-4582-ad5c-0ef80eb62755</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
        <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.14" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
        <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    </ItemGroup>

    <ItemGroup>
      <None Update="appsettings.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\DNSUpdater.Library\DNSUpdater.Library.csproj" />
    </ItemGroup>

</Project>
